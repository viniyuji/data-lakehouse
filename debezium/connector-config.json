{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "postgres",
  "database.password": "postgres",
  "database.dbname": "lakehouse",
  "topic.prefix": "lakehouse",
  "schema.include.list": "public",
  "table.include.list": "public.clients,public.products,public.sales",
  "slot.name": "debezium_lakehouse_slot",
  "publication.name": "dbz_lakehouse_publication",
  "publication.autocreate.mode": "filtered",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "INSERT INTO public.debezium_heartbeat (id, updated_at) VALUES (1, NOW()) ON CONFLICT (id) DO UPDATE SET updated_at = EXCLUDED.updated_at;",
  "max.batch.size": "2048",
  "max.queue.size": "8192",
  "poll.interval.ms": "500",
  "decimal.handling.mode": "double",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false"
}
